[Unit]
Description=SSOT Registry MCP Service - Personal Intelligence Layer OS
Documentation=https://github.com/mgreenspan17/ssot-indexer/tree/main/mcp-registry
After=network.target

[Service]
Type=simple
User=mannieg
Group=mannieg
WorkingDirectory=/opt/mcp-registry/service
ExecStart=/opt/mcp-registry/venv/bin/python /opt/mcp-registry/service/app.py
Restart=always
RestartSec=5
StandardError=journal
StandardOutput=journal
SyslogIdentifier=mcp-registry
Environment=PYTHONUNBUFFERED=1
Environment=REGISTRY_DIR=/opt/mcp-registry/registry

[Install]
WantedBy=multi-user.target
