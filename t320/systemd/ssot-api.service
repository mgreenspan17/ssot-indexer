[Unit]
Description=SSOT API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ssot-indexer
EnvironmentFile=-/etc/ssot-indexer.env
Environment=SSOT_REGISTRY_URL=http://127.0.0.1:9000
Environment=SSOT_REGISTRY_ENABLED=true
ExecStart=/opt/ssot-indexer/venv/bin/python -m cli serve --host 0.0.0.0 --port 8000
User=ssot
Group=ssot
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/data/ssot

[Install]
WantedBy=multi-user.target
