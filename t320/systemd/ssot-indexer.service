[Unit]
Description=SSOT Indexer Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ssot-indexer
EnvironmentFile=-/etc/ssot-indexer.env
ExecStart=/opt/ssot-indexer/t320/update.sh
User=ssot
Group=ssot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/ssot /var/log/ssot-indexer

[Install]
WantedBy=multi-user.target
