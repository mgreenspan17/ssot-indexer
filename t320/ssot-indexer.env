# SSOT Indexer Environment Configuration
# RAID Storage paths - all data stored on 3.4TB RAID volume (/srv/data)

# Logging
SSOT_LOG_DIR=/srv/data/ssot/logs

# Ingestion
SSOT_INGESTION_DIR=/srv/data/ssot/ingestion

# Graph storage
SSOT_GRAPH_DIR=/srv/data/ssot/graph

# Consolidation
SSOT_CONSOLIDATION_DIR=/srv/data/ssot/consolidation

# Temporary files
SSOT_TMP_DIR=/srv/data/ssot/tmp

# MCP Registry
SSOT_REGISTRY_ENABLED=true
SSOT_REGISTRY_URL=http://127.0.0.1:9000
